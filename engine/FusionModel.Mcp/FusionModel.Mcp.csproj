<Project Sdk="Microsoft.NET.Sdk">

  <!-- MCP server (stdio) over the Fusion Model: lets Claude Desktop / Claude Code / other MCP clients ask the model.
       Read-only; uses the same settings file as the app (or command-line options). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FusionModel.Mcp</AssemblyName>
    <RootNamespace>FusionModel.Mcp</RootNamespace>
    <!-- GraysWMS is a self-contained win-x64 app and references this exe (so FusionModel.Mcp.exe ships next to it).
         .NET 8 refuses a framework-dependent exe under a self-contained one (NETSDK1150), and a framework-dependent
         FusionModel.Mcp.exe would also need .NET installed on the PC — so this exe is always self-contained, win-x64 unless a runtime is given (publish -r ...).
         The check reads this project's own properties, so they must be set here, not on the reference. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FusionModel\FusionModel.csproj" />
  </ItemGroup>

</Project>
