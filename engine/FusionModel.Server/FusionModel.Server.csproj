<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Fusion Model server: the model over HTTP (token auth, row-level security per token user), MCP over HTTP,
       optional refresher; runs as a console app or a Windows service. Signed licences (FusionModel.Licensing). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FusionModel.Server</AssemblyName>
    <RootNamespace>FusionModel.Server</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FusionModel\FusionModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="fusionmodel-server.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="install-service.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
