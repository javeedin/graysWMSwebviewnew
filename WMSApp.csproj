<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Application Info -->
    <AssemblyName>GraysWMS</AssemblyName>
    <Version>12.0.0</Version>
    <AssemblyVersion>12.0.0.0</AssemblyVersion>
    <FileVersion>12.0.0.0</FileVersion>
    <Product>Gray's WMS</Product>
    <Company>Gray's Inc</Company>
    <Description>Gray's Warehouse Management System</Description>

    <!-- Single File Publishing - Self-contained means .NET runtime is included -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Publish trimming (optional - reduces size but may cause issues) -->
    <!-- <PublishTrimmed>true</PublishTrimmed> -->
  </PropertyGroup>

  <!-- engine/ is its own project (net8.0, no Windows APIs): keep its files out of this project's default globs -->
  <ItemGroup>
    <Compile Remove="engine\**" />
    <Compile Remove="tools\**" />
    <EmbeddedResource Remove="engine\**" />
    <!-- Claude CLI setup file: AI Digital Employee runs it / saves it as ClaudeCliSetup.bat -->
    <EmbeddedResource Include="tools\claude-cli-setup.bat" LogicalName="ClaudeCliSetup.bat" />
    <None Remove="engine\**" />
    <ProjectReference Include="engine\FusionModel\FusionModel.csproj" />
    <!-- The MCP server (engine\FusionModel.Mcp, FusionModel.Mcp.exe) is NOT referenced here: Visual Studio's restore of an
         exe referenced by this self-contained app failed (NETSDK1150 / NETSDK1047). create-distribution-folder.bat
         publishes it self-contained and copies it next to GraysWMS.exe; a dev build simply runs without it. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.10" />
    <PackageReference Include="System.DirectoryServices" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Anthropic" Version="12.50.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="9.1.0.7988" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.90.1" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.90.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Web content files bundled into single-file publish -->
  <!-- These are extracted to AppContext.BaseDirectory at runtime  -->
  <!-- then installed to C:\fusion\fusionclientweb\graysWMSwebviewnew\ -->
  <ItemGroup>
    <!-- Root web files -->
    <Content Include="index.html">
